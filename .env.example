DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

SECRET_KEY=            # firma de JWT (HS256) (solo backend de tests o local sin Vault)
ENCRYPTION_KEY=        # clave Fernet para EncryptedString (urlsafe base64, 32 bytes)

# --- Vault JWT (RS256) ---
# JWT_KEY_BACKEND=vault ignora la SECRET_KEY de arriba y firma/valida asimétrico:
# auth usa la privada, gateway solo la pública.
# En el VPS estas van en ~/proyectos/.env (compose las lee por interpolación
# ${...}), NO aquí. Las genera scripts/vault_bootstrap.py.
# Ver docs/deploy-produccion-traefik-vault.md.
# JWT_KEY_BACKEND=vault
# VAULT_ADDR=http://localhost:8200
# VAULT_ROLE_ID_AUTH=
# VAULT_SECRET_ID_AUTH=
# VAULT_ROLE_ID_GATEWAY=
# VAULT_SECRET_ID_GATEWAY=

# --- Botón "Authorize" de Swagger (opcional, solo dev) ---
# El login vive únicamente en el servicio auth. Sin esto, "Authorize" en el Swagger
# de pagos/usuarios/transaccional intenta loguearse contra SU PROPIO puerto y falla
# (404 — ese servicio no tiene /login). Debe apuntar al EDGE (Traefik, :8000): los
# requests del "try it out" tienen que pasar por el ForwardAuth para ganar identidad;
# si van directo al puerto del servicio, llegan sin headers X-User-* y dan 401.
# Es localhost porque quien hace el fetch es el navegador del host, no un contenedor.
# AUTH_LOGIN_URL=http://localhost:8000/api/v1/users/login

# --- Servicio de ML/NLP externo (lo consume transaccional) ---
ML_SERVICE_URL=
# NLP_TIMEOUT=8.0
# ML_MODEL_VERSION=

# --- Auth server-to-server (usuarios -> transaccional, bypassea Traefik) ---
# El catch-all de transaccional (PathPrefix /api/v1) usa jwt-auth (anónimo
# permitido), así que el endpoint interno /notifications/internal/patient-linked
# no puede confiar solo en la red del compose: exige este secreto compartido
# (ver service_transaccional/app/core/internal_auth.py).
INTERNAL_SERVICE_TOKEN=

# --- Stripe (solo el servicio pagos) ---
STRIPE_PUBLIC_KEY=
STRIPE_PRIVATE_KEY=
STRIPE_WEBHOOK_SECRET=
# Precios recurrentes (mode=subscription, renovación automática con tarjeta).
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PREMIUM=
# Precios de pago único (mode=payment). Los usa StripeOneTimeCheckoutStrategy para
# tarjeta única, OXXO y SPEI. Sin ellos, ese checkout truena con RuntimeError.
STRIPE_PRICE_ID_BASIC_ONETIME=
STRIPE_PRICE_ID_PREMIUM_ONETIME=

# --- Frontend ---
FRONTEND_URL=
